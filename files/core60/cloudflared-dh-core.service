[Unit]
Description=Cloudflare Tunnel dh-core (DH Stats connector)
Wants=network-online.target
After=network-online.target digitalhouses-stats.service

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared tunnel run --token-file /etc/cloudflared/token
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
